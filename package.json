{
  "name": "vraj-online-center",
  "version": "1.0.0",
  "private": true,
  "description": "Complete public website and private operating system for Vraj Online Center.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
